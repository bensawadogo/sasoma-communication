{
  "_commentaire": "Réglages du serveur MCP delegue-ia (scripts/delegue-ia/). Identifiants OpenRouter vérifiés le 13/11/2026 sur https://openrouter.ai/api/v1/models. Prix de référence en $ par million de tokens (entrée, sortie) : le serveur prend le plus élevé entre ce prix et le prix en direct. La clé OpenRouter n'est JAMAIS dans ce fichier : variable d'environnement OPENROUTER_API_KEY.",
  "plafonds": {
    "par_appel_usd": 0.25,
    "par_jour_usd": 2,
    "par_mois_usd": 15,
    "seuil_annonce_usd": 0.05,
    "sortie_max_tokens": 4000,
    "delai_secondes": 120
  },
  "fichiers": {
    "dossiers_autorises": ["clients", "knowledge", "brouillons", "docs", "recherches", "evals", "config"],
    "classe_minimale": {
      "clients": "client",
      "brouillons": "client",
      "knowledge": "interne",
      "docs": "interne",
      "recherches": "interne",
      "evals": "interne",
      "config": "interne"
    },
    "extensions": [".md", ".txt", ".csv", ".json"],
    "taille_max_octets": 60000,
    "total_max_octets": 200000
  },
  "images": {
    "_commentaire": "Photos : seulement dans photos-clients/ (dossier non poussé sur GitHub). Toute photo impose la classe client. Les métadonnées (EXIF, position GPS, appareil) sont retirées avant l'envoi.",
    "dossier": "photos-clients",
    "extensions": [".jpg", ".jpeg", ".png"],
    "taille_max_octets": 4000000,
    "max_par_appel": 4,
    "tokens_par_image_estimes": 2000
  },
  "detection": {
    "_commentaire": "Mots qui font passer un texte en classe client, en plus des noms de fiches dans clients/ (sasoma, etc.).",
    "mots_en_plus": ["petrov", "petrovoll"]
  },
  "classes": {
    "_commentaire": "public = déjà publié ou sans lien avec un client ni avec le projet. interne = règles, méthodes, docs du projet. client = tout ce qui touche un client (faits, brouillons, chiffres). La classe appliquée est la plus haute entre celle déclarée et celle détectée par le serveur (fichiers lus, noms de clients dans le texte).",
    "public": { "zones": ["occidentale", "chinoise"], "conservation_zero": false, "contexte_projet": false },
    "interne": { "zones": ["occidentale"], "conservation_zero": true, "contexte_projet": true },
    "client": { "zones": ["occidentale"], "conservation_zero": true, "contexte_projet": true }
  },
